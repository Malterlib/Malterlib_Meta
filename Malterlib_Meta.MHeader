Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Meta}"
{
	%Group "Meta"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Meta/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Meta: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Meta"
	{
		!!MalterlibLibrary_Meta true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Meta: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Meta true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Meta"
	//MalterlibTestFiles_Malterlib_Meta: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

