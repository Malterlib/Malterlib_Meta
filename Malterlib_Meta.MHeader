Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Meta}"
{
	%Group Meta
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Meta/^*"
		}
		%File "Source/*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Meta true
	{
		&
		{
			MalterlibLibrary_Meta ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Meta;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Meta true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Meta true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Meta true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Meta;@(MalterlibTests)"
	//MalterlibTestFiles_Malterlib_Meta "@('Test/*'->MakeAbsolute())"
}

